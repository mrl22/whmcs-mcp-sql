# Docker Desktop: host.docker.internal reaches MySQL on the host.
# For remote WHMCS use its MySQL hostname. No WHMCS API credentials are needed.
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_DATABASE=whmcs_database
MYSQL_USER=whmcs_user
MYSQL_PASSWORD=
# Every MYSQL_* credential also accepts a matching *_FILE Docker secret path.
# MYSQL_PASSWORD_FILE=/run/secrets/mysql_password
MYSQL_SSL=false
# MYSQL_SSL_CA_FILE=/run/secrets/mysql_ca
MYSQL_POOL_SIZE=5
MCP_TRANSPORT=http
MCP_HTTP_HOST=0.0.0.0
MCP_HTTP_PORT=3100
MCP_BIND_ADDRESS=127.0.0.1
MCP_PUBLISH_PORT=3100
MCP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# For a reverse proxy, add its external hostname to MCP_ALLOWED_HOSTS.
# Browser origins are denied unless explicitly listed; non-browser MCP clients need no Origin.
MCP_ALLOWED_ORIGINS=
MCP_MAX_ROWS=500
MCP_QUERY_TIMEOUT_MS=15000
MCP_MAX_RESPONSE_BYTES=1048576
MCP_MAX_CELL_CHARS=8192
REPORT_TIMEZONE=Europe/London
